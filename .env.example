# HackFlix Environment Configuration

# OpenSubtitles API Configuration
# Get your API key from: https://www.opensubtitles.com/api
OPENSUBTITLES_API_KEY=your_api_key_here
OPENSUBTITLES_USERNAME=your_username  # Optional, for >5 downloads/day
OPENSUBTITLES_PASSWORD=your_password  # Optional

# Google Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# TMDB API Configuration (for metadata collection)
# Get your API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Catalog Configuration
# URL to fetch catalog.json from (GitHub Pages or custom hosting)
CATALOG_URL=https://YOUR_USERNAME.github.io/hackflix-catalog/catalog.json

# Database Configuration
DATABASE_PATH=./hackflix.db

# Optional: TTS API (when voiceover feature is implemented)
# TTS_API_KEY=your_tts_api_key_here
